# Copia este archivo a .env y ajusta los valores.
PORT=3000
HOST=0.0.0.0
# URL pública con la que se construyen los enlaces cortos.
BASE_URL=http://localhost:3000
DATABASE_URL=postgres://acortador:acortador@localhost:5432/acortador
REDIS_URL=redis://localhost:6379
# Cambia esto en producción: firma los JWT y anonimiza a los visitantes.
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
