{
  "name": "acortador-urls",
  "version": "1.0.0",
  "description": "API REST para acortar URLs con autenticación, rate limiting y estadísticas de clics",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint"
  },
  "author": "Jorgedngc",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/jwt": "^10.2.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/type-provider-typebox": "^6.3.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.7",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "typebox": "^1.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
